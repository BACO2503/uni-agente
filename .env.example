# Copia este archivo a .env y completa tus keys.
# cp .env.example .env

# --- Proveedor de generación ---
# fallback: intenta gemini -> groq -> cerebras, en ese orden (recomendado)
# también puedes forzar uno solo: gemini | groq | cerebras | echo
LLM=fallback
LLM_FALLBACK_ORDER=gemini,groq,cerebras

# Gemini: gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Groq: gratis en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras (opcional): gratis en https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# --- Embeddings ---
# gemini (recomendado, gratis) | hash (sin red, solo para pruebas)
EMBEDDER=gemini
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Recuperación / troceado ---
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- OCR (para PDFs escaneados) ---
OCR_ENABLED=true
OCR_LANG=spa+eng
OCR_MIN_CHARS_PER_PAGE=25

# --- Servidor ---
PORT=8000
CORS_ORIGINS=*
AGENT_NAME=Asesor UNI
